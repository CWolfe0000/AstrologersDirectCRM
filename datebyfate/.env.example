# Postgres connection string.
DATABASE_URL=postgres://postgres@localhost:5432/datebyfate

# 32 random bytes, base64. Encrypts birth data at rest.
# Generate with: openssl rand -base64 32   — never change it once data exists.
APP_ENCRYPTION_KEY=

# Public URL of the site (used in email links and Stripe redirects).
APP_URL=http://localhost:3000

# Email (password reset). Without RESEND_API_KEY, emails go to the outbox table and the server log.
RESEND_API_KEY=
EMAIL_FROM=Datebyfate <no-reply@example.com>

# Stripe. Create one product with a monthly and a yearly price, then paste the price ids.
# Webhook endpoint: <APP_URL>/api/stripe/webhook
#   events: checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Swiss Ephemeris. "confirmed" once a Professional License covers Datebyfate; "staging" for non-commercial testing.
SWISS_EPHEMERIS_LICENSE=staging
SWEPH_EPHE_PATH=

# Birthplace search. Optional GeoNames account for small towns; without it a built-in list of ~7,300 cities is used.
GEONAMES_USERNAME=
