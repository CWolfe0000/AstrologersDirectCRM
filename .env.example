# Postgres connection string (Neon in production).
DATABASE_URL=postgres://postgres@localhost:5432/astrologersdirect

# 32 random bytes, base64. Encrypts birth data, notes and observations at rest.
# Generate with: openssl rand -base64 32   — never change it once data exists.
APP_ENCRYPTION_KEY=

# Public URL of the app (used in email links).
APP_URL=http://localhost:3000

# Email. Without RESEND_API_KEY, emails are written to the outbox table and the server log.
RESEND_API_KEY=
EMAIL_FROM=AstrologersDirect <no-reply@example.com>

# "server" (default): real accounts and database. "demo": seeded data in the browser, no backend.
NEXT_PUBLIC_DATA_MODE=server

# File storage. "local" (default) keeps files on disk under STORAGE_DIR — for development.
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2…): browsers upload directly with signed URLs.
STORAGE_DRIVER=local
STORAGE_DIR=.uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Scheduled jobs (consultation reminders). Vercel Cron sends this as a bearer token.
CRON_SECRET=

# Swiss Ephemeris. "confirmed" once the Professional License covers this entity and product; "staging" for non-commercial testing.
SWISS_EPHEMERIS_LICENSE=staging
# Directory with sepl_18.se1, semo_18.se1, seas_18.se1 (npm run ephemeris downloads them to .sweph-ephe).
SWEPH_EPHE_PATH=
